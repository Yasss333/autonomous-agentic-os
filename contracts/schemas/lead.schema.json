{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead.schema.json",
  "title": "Lead",
  "type": "object",
  "required": ["id", "type", "name", "version", "email", "stage", "currency", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "lead" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1 },
    "email": { "type": "string", "format": "email" },
    "company_id": { "type": ["string", "null"], "format": "uuid" },
    "company_name": { "type": ["string", "null"] },
    "stage": { "enum": ["new", "contacted", "qualified", "customer", "lost"] },
    "last_contact_date": { "type": ["string", "null"], "format": "date" },
    "value": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
