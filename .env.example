# Copy to .env (repo root) or api/.env and fill in. Never commit .env.

# Neon pooled connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Neon direct (non-pooled) endpoint for migrations. Optional; falls back to DATABASE_URL.
DATABASE_DIRECT_URL=

# Set to "production" when deployed publicly. Enables Secure cookies.
APP_ENV=development
SESSION_COOKIE_SECURE=

# Comma-separated extra allowed browser origins for public deployment.
ALLOWED_ORIGINS=

# Workspace slug used by seed/provision scripts.
SEED_WORKSPACE_SLUG=demo

# --- Phase 2 ---
# Shared secret authorizing the trusted laptop worker (runner/worker.py).
# The API compares its SHA-256; keep it out of source control.
RUNNER_TOKEN=

# Owner's sponsored OpenRouter key — set on the WORKER environment only,
# never on the public API and never in the database.
OPENROUTER_API_KEY=

# Comma-separated OpenRouter ":free" catalog IDs the demo may use.
# Defaults are live catalog IDs; paid models are never allowed.
FREE_MODEL_ALLOWLIST=

# Set to 1 ONLY for local pipeline verification: the worker emits a labelled
# test-fixture bundle instead of calling a model. Never enable in public demo.
RUNNER_FIXTURE=
