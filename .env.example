# Copy to .env (repo root) or api/.env and fill in. Never commit .env.

# Neon pooled connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Neon direct (non-pooled) endpoint for migrations. Optional; falls back to DATABASE_URL.
DATABASE_DIRECT_URL=

# Set to "production" when deployed publicly. Enables Secure cookies.
APP_ENV=development
SESSION_COOKIE_SECURE=

# Comma-separated extra allowed browser origins for public deployment.
ALLOWED_ORIGINS=

# Workspace slug used by seed/provision scripts.
SEED_WORKSPACE_SLUG=demo
